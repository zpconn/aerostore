   output.len() <= bucket,\n            forall|j: int| 0 <= j < output.len() ==> output@[j] < bucket,\n            forall|j: int| 0 <= j < input.len() ==> input@[j] < bucket_count,\n            forall|b: usize| b < bucket_count ==> (present@[b as int] <==> input@.contains(b)),\n            forall|b: usize| output@.contains(b) <==> (b < bucket && input@.contains(b)),\n        decreases bucket_count - bucket,\n    @*/\n    {\n        if present[bucket] {\n            output.push(bucket);\n        }\n        bucket += 1;\n    }\n    /*@ proof { membership_length_bound(output@, input@); } @*/\n    Ok(output)\n}","attr_info":{"attributes":[{"DocComment":" Return the same canonical bucket set using one presence flag per bucket."},{"DocComment":""},{"DocComment":" Invalid inputs are rejected before allocating the flags. Allocation failure"},{"DocComment":" retains Rust's normal allocator behavior; these helpers do not implement a"},{"DocComment":" fallible allocator or promise success for unbounded `bucket_count` values."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":28},{"Deduplicated":0}],"output":{"Deduplicated":30}},"src":"Normal","body":{"Structured":{"span":{"Value":[124,{"data":{"file_id":0,"beg":{"line":84,"col":0},"end":{"line":154,"col":1}},"generated_from_span":null}]},"bound_body_regions":32,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Value":[125,{"data":{"file_id":0,"beg":{"line":84,"col":73},"end":{"line":84,"col":98}},"generated_from_span":null}]},"ty":{"Deduplicated":30}},{"index":1,"name":"input","span":{"Value":[126,{"data":{"file_id":0,"beg":{"line":84,"col