"attr_info":{"attributes":[{"DocComment":" Returns a mutable slice containing the entire array. Equivalent to"},{"DocComment":" `&mut s[..]`."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":0}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":6},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[12,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":9},"Mut"]}]}],"output":{"Value":[13,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":11},"Mut"]}]}},"src":"Normal","body":"Opaque"},{"def_id":2,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["repeat",0]}],"span":{"Untagged":{"data":{"file_id":2,"beg":{"line":53,"col":0},"end":{"line":53,"col":57}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an array of type `[T; N]` by repeatedly cloning a value."},{"DocComment":""},{"DocComment":" This is the same as `[val; N]`, but it also works for types that do not"},{"DocComment":" implement [`Copy`]."},{"DocComment":""},{"DocComment":" The provided value will be used as an element of the resulting array and"},{"DocComment":" will be cloned N - 1 times to fill up the rest. If N is zero, the value"},{"DocComment":" will be dropped."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" Creating multiple copies of a `String`:"},{"DocComment":" ```rust"},{"DocComment":" use std::array;"},{"DocComment":""},{"DocComment":" let string = \"Hello there!\".to_string();"},{"DocComment":" let strings = array::repeat(string);"},{"DocComment":" assert_eq!(strings, [\"Hello there!\", \"Hello there!\"]);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Invariant"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":0}}],"trait_clauses":[{"clause_id":0,"span":{"Value":[1,{"data":{"file_id":2,"beg":{"line":53,"col":17},"end":{"line":53,"col":22}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":6}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":6}],"output":{"Deduplicated":9}},"src":"Normal","body":"Opaque"},{"def_id":3,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Trait":0}},{"Ident":["index",0]}],"span":{"Untagged":{"data":{"file_id":2,"beg":{"line":389,"col":4},"end":{"line":389,"col":46}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Unknown"},{"index":1,"name":"I","variance":"Unknown"},{"index":2,"name":"Clause0_Output","variance":"Invariant"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":0}}],"trait_clauses":[{"clause_id":0,"span":{"Value":[2,{"data":{"file_id":2,"beg":{"line":384,"col":9},"end":{"line":384,"col":25}},"generated_from_span":null}]},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":11},{"Deduplicated":7},{"Value":[14,{"TypeVar":{"Free":2}}]}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"ty