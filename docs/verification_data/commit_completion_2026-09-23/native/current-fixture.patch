+#[test]
+fn p1_reader_key_move_rejects_staged_write_then_fresh_retry_commits() {
+    use std::sync::mpsc;
+    use std::time::Duration;
+
+    for older_writer in [false, true] {
+        let (arena, table, index) = fixture(&[Row::live(10), Row::vacant()]);
+        let table = Arc::new(table);
+        let writer_table = Arc::clone(&table);
+        let (begin, begin_rx) = mpsc::channel();
+        let (ready, ready_rx) = mpsc::channel();
+        let (publish, publish_rx) = mpsc::channel();
+        let writer = std::thread::spawn(move || {
+            begin_rx.recv_timeout(Duration::from_secs(10)).unwrap();
+            let mut tx = writer_table.begin_transaction().unwrap();
+            writer_table.write(&mut tx, 0, Row::live(20)).unwrap();
+            ready.send(()).unwrap();
+            publish_rx.recv_timeout(Duration::from_secs(10)).unwrap();
+            writer_table.commit(&mut tx)
+        });
+        if older_writer {
+            begin.send(()).unwrap();
+            ready_rx.recv_timeout(Duration::from_secs(10)).unwrap();
+        }
+        let mut reader = table.begin_transaction().unwrap();
+        let before = scan(&table, &mut reader, &index, &eq(10));
+        let initially_absent = scan(&table, &mut reader, &index, &eq(20));
+        table.write(&mut reader, 1, Row::live(99)).unwrap();
+        let own = scan(&table, &mut reader, &index, &eq(99));
+        let repeated = scan(&table, &mut reader, &index, &eq(10));
+        if !older_writer {
+            begin.send(()).unwrap();
+            ready_rx.recv_timeout(Duration::from_secs(10)).unwrap();
+        }
+        publish.send(()).unwrap();
+        let writer_outcome = writer.join().unwrap();
+        let reader_outcome = table.commit(&mut reader);
+        assert_eq!(writer_outcome, Ok(1));
+        assert_eq!(before, vec![0]);
+        assert!(initially_absent.is_empty());
+        assert_eq!(own, vec![1]);
+        assert_eq!(repeated, vec![0]);
+        assert_eq!(
+            reader_outcome,
+            Err(OccError::SerializationFailure),
+            "p1-native: a moved predicate must reject the reader's complete write transaction"
+        );
+        assert_eq!(table.latest_value(1).unwrap(), Some(Row::vacant()));
+        assert_eq!(
+            index.try_entries().unwrap(),
+            vec![(IndexValue::I64(20), 0)],
+            "p1-native: key move and rejected reader must leave exactly the new committed posting"
+        );
+        assert!(arena.create_snapshot().in_flight_txids().is_empty());
+        let mut retry = table.begin_transaction().unwrap();
+        assert!(scan(&table, &mut retry, &index, &eq(10)).is_empty());
+        assert_eq!(scan(&table, &mut retry, &index, &eq(20)), vec![0]);
+        table.write(&mut retry, 1, Row::live(99)).unwrap();
+        assert_eq!(scan(&table, &mut retry, &index, &eq(99)), vec![1]);
+        assert_eq!(table.commit(&mut retry), Ok(1));
+        assert_eq!(table.latest_value(1).unwrap(), Some(Row::live(99)));
+        assert_eq!(
+            index.try_entries().unwrap(),
+            vec![(IndexValue::I64(20), 0), (IndexValue::I64(99), 1)]
+        );
+        assert!(arena.create_snapshot().in_flight_txids().is_empty());
+    }
 }
 
