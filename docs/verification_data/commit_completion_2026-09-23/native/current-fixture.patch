+#[test]
+fn p1_two_workers_empty_creation_retries_to_the_single_winner() {
+    use std::sync::mpsc;
+    use std::time::Duration;
+
+    // Registration order is fixed; either the older or newer worker may win.
+    for winner in 0..2 {
+        let (arena, table, index) = fixture(&[Row::vacant(), Row::vacant()]);
+        let table = Arc::new(table);
+        let mut workers = Vec::new();
+        let mut commands = Vec::new();
+        let mut completions = Vec::new();
+        for row_id in 0..2 {
+            let table = Arc::clone(&table);
+            let index = index.clone();
+            let (ready, ready_rx) = mpsc::channel();
+            let (command, command_rx) = mpsc::channel();
+            let (completed, completed_rx) = mpsc::channel();
+            workers.push(std::thread::spawn(move || {
+                let mut tx = table.begin_transaction().unwrap();
+                let first = scan(&table, &mut tx, &index, &eq(42));
+                let repeated = scan(&table, &mut tx, &index, &eq(42));
+                table.write(&mut tx, row_id, Row::live(42)).unwrap();
+                let own = scan(&table, &mut tx, &index, &eq(42));
+                ready.send(()).unwrap();
+                command_rx.recv_timeout(Duration::from_secs(10)).unwrap();
+                let outcome = table.commit(&mut tx);
+                completed.send(()).unwrap();
+                command_rx.recv_timeout(Duration::from_secs(10)).unwrap();
+                // The application retries from a new snapshot, observes the
+                // existing logical row, and performs no duplicate insertion.
+                let mut retry = table.begin_transaction().unwrap();
+                let observed = scan(&table, &mut retry, &index, &eq(42));
+                let retry_outcome = table.commit(&mut retry);
+                (first, repeated, own, outcome, observed, retry_outcome)
+            }));
+            // This makes row 0's transaction older without using a sleep.
+            ready_rx.recv_timeout(Duration::from_secs(10)).unwrap();
+            commands.push(command);
+            completions.push(completed_rx);
+        }
+        commands[winner].send(()).unwrap();
+        completions[winner]
+            .recv_timeout(Duration::from_secs(10))
+            .unwrap();
+        commands[1 - winner].send(()).unwrap();
+        completions[1 - winner]
+            .recv_timeout(Duration::from_secs(10))
+            .unwrap();
+        for command in commands {
+            command.send(()).unwrap();
+        }
+        // Join both threads before reporting a failed semantic assertion.
+        let observations: Vec<_> = workers
+            .into_iter()
+            .map(|worker| worker.join().unwrap())
+            .collect();
+        for (row_id, observation) in observations.iter().enumerate() {
+            assert_eq!(
+                observation.3,
+                if row_id == winner {
+                    Ok(1)
+                } else {
+                    Err(OccError::SerializationFailure)
+                },
+                "p1-native: two empty-query creators must have exactly one committed winner"
+            );
+        }
+        for (row_id, (first, repeated, own, outcome, retry, retry_outcome)) in
+            observations.into_iter().enumerate()
+        {
+            assert!(first.is_empty() && repeated.is_empty());
+            assert_eq!(
+                own,
+                vec![row_id],
+                "p1-native: indexed lookup must include this worker's pending creation"
+            );
+            let _ = outcome;
+            assert_eq!(retry, vec![winner]);
+            assert_eq!(retry_outcome, Ok(0));
+        }
+        assert_eq!(
+            index.try_entries().unwrap(),
+            vec![(IndexValue::I64(42), winner)]
+        );
+        assert_eq!(table.latest_value(1 - winner).unwrap(), Some(Row::vacant()));
+        assert!(arena.create_snapshot().in_flight_txids().is_empty());
+    }
+}
