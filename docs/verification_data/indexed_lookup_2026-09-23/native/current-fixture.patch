+                                payload: 100,
+                            },
+                        )
+                        .unwrap();
+                    let committed = writer_table.commit(&mut deleting);
+                    observed.lock().unwrap().0.push(committed.is_ok());
+                    if committed.is_err() {
+                        let _ = writer_table.abort(&mut deleting);
