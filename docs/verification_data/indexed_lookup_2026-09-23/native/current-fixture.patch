+            table
+                .write(
+                    &mut reuse,
+                    0,
+                    PredicateRow {
+                        key: Some(99),
+                        payload: 999,
+                    },
+                )
+                .unwrap();
+            table.commit(&mut reuse).unwrap();
+            assert_eq!(
+                table.row_head_offset(0).unwrap(),
+                original_offset,
+                "the protected version becomes reusable after its reader finishes"
+            );
+            no_live_transactions(&table);
+        }
+    }
