+#[test]
+fn planning_unchanged_key_keeps_posting_and_empty_predicate_valid() {
+    let (arena, table, index) = fixture(&[Row::live(10)]);
+    let base = table.row_head_offset(0).unwrap();
+    let mut absent = table.begin_transaction().unwrap();
+    assert!(scan(&table, &mut absent, &index, &eq(99)).is_empty());
+    let mut writer = table.begin_transaction().unwrap();
+    table
+        .write_with_dirty_mask(&mut writer, 0, Row::live(99), 1)
+        .unwrap();
+    let final_row = Row {
+        key: 10,
+        active: true,
+        value: 123,
+    };
+    table
+        .write_with_dirty_mask(&mut writer, 0, final_row, 4)
+        .unwrap();
+    let record = table.commit_with_record(&mut writer).unwrap();
+    assert_eq!(
+        record.writes,
+        vec![OccCommittedWrite {
+            row_id: 0,
+            base_offset: base,
+            new_offset: table.row_head_offset(0).unwrap(),
+            base_value: Row::live(10),
+            value: final_row,
+            dirty_columns_bitmask: 4,
+        }]
+    );
+    assert_eq!(
+        index.try_entries().unwrap(),
+        vec![(IndexValue::I64(10), 0)],
+        "planning-native: unchanged final key must retain exactly the original posting"
+    );
+    assert_eq!(
+        table.commit(&mut absent),
+        Ok(0),
+        "planning-native: abandoned intermediate key must not invalidate its empty predicate"
+    );
+    assert_eq!(table.latest_value(0).unwrap(), Some(final_row));
+    assert!(arena.create_snapshot().in_flight_txids().is_empty());
+}
