+#[test]
+fn planning_stale_base_rejects_all_staged_rows_before_publication() {
+    for older_winner in [false, true] {
+        let (arena, table, index) = fixture(&[Row::live(10), Row::live(20)]);
+        let mut winner = older_winner.then(|| table.begin_transaction().unwrap());
+        let mut stale = table.begin_transaction().unwrap();
+        // No explicit row/index reads: this case isolates write-base validation.
+        // The uncontested row sorts before the stale row, so skipping validation
+        // would publish a prefix before the later stale-base CAS fails.
+        table.write(&mut stale, 0, Row::live(11)).unwrap();
+        table.write(&mut stale, 1, Row::live(21)).unwrap();
+        table.write(&mut stale, 1, Row::live(22)).unwrap();
+        let winner = winner.get_or_insert_with(|| table.begin_transaction().unwrap());
+        table.write(winner, 1, Row::live(25)).unwrap();
+        table.commit(winner).unwrap();
+        let heads: Vec<_> = (0..2)
+            .map(|id| table.row_head_offset(id).unwrap())
+            .collect();
+        let outcome = table.commit_with_record(&mut stale);
+        assert_eq!(
+            table.row_head_offset(0).unwrap(),
+            heads[0],
+            "planning-native: stale base must reject before publishing any staged row"
+        );
+        assert_eq!(table.row_head_offset(1).unwrap(), heads[1]);
+        assert_eq!(
+            outcome,
+            Err(OccError::SerializationFailure),
+            "planning-native: stale base must be a clean serialization rejection"
+        );
+        assert_eq!(
+            index.try_entries().unwrap(),
+            vec![(IndexValue::I64(10), 0), (IndexValue::I64(25), 1)]
+        );
+        assert_eq!(table.latest_value(0).unwrap(), Some(Row::live(10)));
+        assert_eq!(table.latest_value(1).unwrap(), Some(Row::live(25)));
+        assert!(arena.create_snapshot().in_flight_txids().is_empty());
+        let mut fresh = table.begin_transaction().unwrap();
+        table.write(&mut fresh, 0, Row::live(11)).unwrap();
+        table.write(&mut fresh, 1, Row::live(22)).unwrap();
+        assert_eq!(table.commit(&mut fresh), Ok(2));
+        assert_eq!(
+            index.try_entries().unwrap(),
+            vec![(IndexValue::I64(11), 0), (IndexValue::I64(22), 1)]
+        );
+        assert!(arena.create_snapshot().in_flight_txids().is_empty());
+    }
+}
