+fn planning_final_writes_preserve_exact_report_after_savepoint_rollback() {
+    let (arena, table, index) = fixture(&[Row::live(10), Row::live(20), Row::vacant()]);
+    let originals = [Row::live(10), Row::live(20), Row::vacant()];
+    let bases: Vec<_> = (0..3)
+        .map(|id| table.row_head_offset(id).unwrap())
+        .collect();
+    let mut tx = table.begin_transaction().unwrap();
+    let txid = tx.txid();
+    // Interleave rows so final selection must use the last retained write for
+    // each row, then emit row order independently of staging order.
+    table
+        .write_with_dirty_mask(&mut tx, 2, Row::live(70), 2)
+        .unwrap();
+    table
+        .write_with_dirty_mask(&mut tx, 0, Row::live(11), 1)
+        .unwrap();
+    table
+        .write_with_dirty_mask(&mut tx, 1, Row::live(21), 4)
+        .unwrap();
+    table
+        .write_with_dirty_mask(&mut tx, 0, Row::live(12), 8)
+        .unwrap();
+    table.savepoint(&mut tx, "retained").unwrap();
+    table
+        .write_with_dirty_mask(&mut tx, 0, Row::live(99), 32)
+        .unwrap();
+    table
+        .write_with_dirty_mask(&mut tx, 2, Row::vacant(), 64)
+        .unwrap();
+    table
+        .write_with_dirty_mask(&mut tx, 1, Row::live(91), 128)
+        .unwrap();
+    table.rollback_to(&mut tx, "retained").unwrap();
+    table
+        .write_with_dirty_mask(&mut tx, 1, Row::live(22), 16)
+        .unwrap();
+    let final_rows = [Row::live(12), Row::live(22), Row::live(70)];
+    let record = table.commit_with_record(&mut tx).unwrap();
+    let expected: Vec<_> = (0..3)
+        .map(|row_id| OccCommittedWrite {
+            row_id,
+            base_offset: bases[row_id],
+            new_offset: table.row_head_offset(row_id).unwrap(),
+            base_value: originals[row_id],
+            value: final_rows[row_id],
+            dirty_columns_bitmask: [8, 16, 2][row_id],
+        })
+        .collect();
+    assert_eq!(record.txid, txid);
+    assert_eq!(record.writes, expected,
+        "planning-native: report must contain exactly each row's last retained write and original base");
+    for (row_id, value) in final_rows.into_iter().enumerate() {
+        assert_eq!(table.latest_value(row_id).unwrap(), Some(value));
+        assert_ne!(table.row_head_offset(row_id).unwrap(), bases[row_id]);
+    }
+    assert_eq!(
+        index.try_entries().unwrap(),
+        vec![
+            (IndexValue::I64(12), 0),
+            (IndexValue::I64(22), 1),
+            (IndexValue::I64(70), 2)
+        ],
+        "planning-native: only original-to-final key changes may affect postings"
+    );
+    assert!(arena.create_snapshot().in_flight_txids().is_empty());
+}
