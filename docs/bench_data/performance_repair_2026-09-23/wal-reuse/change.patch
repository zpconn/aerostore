new file mode 100644
--- /dev/null
+++ b/aerostore_core/tests/wal_serializer_allocations.rs
@@ -0,0 +1,103 @@
+//! Native warmed commit allocation evidence, independent of wall-clock timing.
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::cell::Cell;
+use std::sync::Arc;
+
+use aerostore_core::{OccCommitter, OccTable, SharedWalRing, ShmArena};
+
+#[derive(Clone, Copy, Default)]
+struct Counts {
+    allocations: u64,
+    reallocations: u64,
+    deallocations: u64,
+    allocated_bytes: u64,
+    scratch_8192_allocations: u64,
+}
+
+thread_local! {
+    static COUNTS: Cell<Option<Counts>> = const { Cell::new(None) };
+}
+
+struct CountingAllocator;
+
+fn account(size: usize, kind: u8) {
+    let _ = COUNTS.try_with(|slot| {
+        if let Some(mut counts) = slot.get() {
+            match kind {
+                0 => {
+                    counts.allocations += 1;
+                    counts.allocated_bytes += size as u64;
+                    counts.scratch_8192_allocations += u64::from(size == 8192);
+                }
+                1 => {
+                    counts.reallocations += 1;
+                    counts.allocated_bytes += size as u64;
+                    counts.scratch_8192_allocations += u64::from(size == 8192);
+                }
+                _ => counts.deallocations += 1,
+            }
+            slot.set(Some(counts));
+        }
+    });
+}
+
+// The counter only observes this test thread while enabled. System remains the
+// allocator; no allocation is performed by the accounting path.
+unsafe impl GlobalAlloc for CountingAllocator {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        account(layout.size(), 0);
+        System.alloc(layout)
+    }
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        account(layout.size(), 0);
+        System.alloc_zeroed(layout)
+    }
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        account(new_size, 1);
+        System.realloc(ptr, layout, new_size)
+    }
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        account(layout.size(), 2);
+        System.dealloc(ptr, layout)
+    }
+}
+
+#[global_allocator]
+static ALLOCATOR: CountingAllocator = CountingAllocator;
+
+#[test]
+fn warmed_native_commits_do_not_reallocate_the_8192_byte_serialization_scratch() {
+    let arena = Arc::new(ShmArena::new(8 << 20).unwrap());
+    let table = OccTable::<u64>::new(Arc::clone(&arena), 1).unwrap();
+    table.seed_row(0, 0).unwrap();
+    let ring = SharedWalRing::<8, 1024>::create(arena).unwrap();
+    let mut committer = OccCommitter::new_asynchronous(ring.clone());
+    for value in 1..=2 {
+        let mut tx = table.begin_transaction().unwrap();
+        table.write(&mut tx, 0, value).unwrap();
+        committer.commit(&table, &mut tx).unwrap();
+        ring.pop_bytes().unwrap().unwrap();
+    }
+    let mut totals = Counts::default();
+    for value in 3..103 {
+        let mut tx = table.begin_transaction().unwrap();
+        table.write(&mut tx, 0, value).unwrap();
+        COUNTS.with(|slot| slot.set(Some(Counts::default())));
+        let result = committer.commit(&table, &mut tx);
+        let counts = COUNTS.with(|slot| slot.replace(None).unwrap());
+        result.unwrap();
+        ring.pop_bytes().unwrap().unwrap();
+        totals.allocations += counts.allocations;
+        totals.reallocations += counts.reallocations;
+        totals.deallocations += counts.deallocations;
+        totals.allocated_bytes += counts.allocated_bytes;
+        totals.scratch_8192_allocations += counts.scratch_8192_allocations;
+    }
+    println!(
+        "wal_serializer_allocation_evidence: commits=100 allocations={} reallocations={} deallocations={} allocated_bytes={} scratch_8192_allocations={}",
+        totals.allocations, totals.reallocations, totals.deallocations,
+        totals.allocated_bytes, totals.scratch_8192_allocations,
+    );
+    assert_eq!(totals.scratch_8192_allocations, 0);
+    assert_eq!(table.latest_value(0).unwrap(), Some(102));
+}
