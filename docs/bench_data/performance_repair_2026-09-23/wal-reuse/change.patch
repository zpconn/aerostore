+        let unwind = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let mut lease = buffer.lease();
+            let _ = lease.with_serializer(|serializer| {
+                leave_partial_serialization(serializer);
+                panic!("injected after partial archive");
+            });
+        }));
+        assert!(unwind.is_err());
+        assert_eq!(buffer.output.len(), 0);
+        assert_eq!(buffer.output.capacity(), 0);
+        assert_eq!(buffer.scratch.as_ref() as *const _, scratch);
+        let commit = record(512, 1);
+        let expected = serialize_commit_record(&commit).unwrap();
+        let mut lease = buffer.lease();
+        lease.serialize_commit(&commit).unwrap();
+        assert_eq!(lease.as_slice(), expected.as_slice());
+    }
+
+    #[test]
+    fn successful_oversized_frame_is_valid_but_not_retained_between_calls() {
+        let mut buffer = WalCommitBuffer::default();
+        let commit = record(1, MAX_RETAINED_WAL_OUTPUT_BYTES);
+        let expected = serialize_commit_record(&commit).unwrap();
+        {
+            let mut lease = buffer.lease();
+            lease.serialize_commit(&commit).unwrap();
