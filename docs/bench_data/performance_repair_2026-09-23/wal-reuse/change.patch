+            assert!(lease.as_slice().len() > MAX_RETAINED_WAL_OUTPUT_BYTES);
+        }
+        assert_eq!(buffer.output.capacity(), 0);
+        assert_eq!(buffer.output.len(), 0);
+    }
+}
