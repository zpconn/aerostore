+            txid: 87 + writes as u64,
+            writes: (0..writes)
+                .map(|i| WalRingWrite {
+                    row_id: i as u64,
+                    base_offset: 100 + i as u32,
+                    new_offset: 1000 + i as u32,
+                    value_payload: if i % 2 == 0 {
+                        vec![i as u8; payload_bytes]
+                    } else {
