+
+    struct CountingAllocator;
+
+    fn account_allocation(size: usize, kind: u8) {
+        let _ = ALLOCATION_COUNTS.try_with(|slot| {
+            if let Some(mut count) = slot.get() {
+                match kind {
+                    0 => {
+                        count.allocations += 1;
+                        count.allocated_bytes += size as u64;
+                        count.scratch_8192_allocations +=
+                            u64::from(size == WAL_SERIALIZATION_SCRATCH_BYTES);
+                    }
+                    1 => {
+                        count.reallocations += 1;
+                        count.allocated_bytes += size as u64;
+                    }
+                    _ => count.deallocations += 1,
+                }
+                slot.set(Some(count));
+            }
+        });
+    }
+
+    // Unit-test-only accounting delegates every operation to System and only
+    // records allocations on this thread during the explicit measured region.
+    unsafe impl std::alloc::GlobalAlloc for CountingAllocator {
+        unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+            account_allocation(layout.size(), 0);
+            std::alloc::System.alloc(layout)
+        }
+        unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+            account_allocation(layout.size(), 0);
+            std::alloc::System.alloc_zeroed(layout)
+        }
+        unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+            account_allocation(new_size, 1);
+            std::alloc::System.realloc(ptr, layout, new_size)
+        }
+        unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+            account_allocation(layout.size(), 2);
+            std::alloc::System.dealloc(ptr, layout)
+        }
+    }
+
+    #[global_allocator]
+    static ALLOCATOR: CountingAllocator = CountingAllocator;
+
+    fn allocation_counts(f: impl FnOnce()) -> AllocationCounts {
+        ALLOCATION_COUNTS.with(|slot| slot.set(Some(AllocationCounts::default())));
+        f();
+        ALLOCATION_COUNTS.with(|slot| slot.replace(None).unwrap())
+    }
+
+    #[test]
+    fn warmed_outer_serialization_eliminates_output_and_scratch_heap_allocations() {
+        let commit = record(1, 37);
