+        {
+            let mut lease = buffer.lease();
+            lease.serialize_commit(&commit).unwrap();
+        }
+        let original = allocation_counts(|| {
+            for _ in 0..100 {
+                let bytes = serialize_commit_record(&commit).unwrap();
+                assert_eq!(bytes.as_slice(), expected.as_slice());
+            }
+        });
+        let reused = allocation_counts(|| {
+            for _ in 0..100 {
+                let mut lease = buffer.lease();
+                lease.serialize_commit(&commit).unwrap();
+                assert_eq!(lease.as_slice(), expected.as_slice());
+            }
+        });
+        println!("wal_serializer_heap_evidence: iterations=100 original_allocations={} original_reallocations={} original_deallocations={} original_allocated_bytes={} original_scratch_8192_allocations={} reused_allocations={} reused_reallocations={} reused_deallocations={} reused_allocated_bytes={}",
+            original.allocations, original.reallocations, original.deallocations,
+            original.allocated_bytes, original.scratch_8192_allocations,
+            reused.allocations, reused.reallocations, reused.deallocations,
+            reused.allocated_bytes);
+        assert_eq!(original.scratch_8192_allocations, 100);
+        assert!(original.allocations >= 200);
+        assert_eq!(reused.allocations, 0);
+        assert_eq!(reused.reallocations, 0);
+        assert_eq!(reused.deallocations, 0);
+    }
+
+    fn record(writes: usize, payload_bytes: usize) -> WalRingCommit {
+        WalRingCommit {
