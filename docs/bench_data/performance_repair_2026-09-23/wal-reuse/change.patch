+                .in_flight_txids()
+                .is_empty());
+            let mut retry = table.begin_transaction().unwrap();
+            table
+                .write(&mut retry, 0, FaultyRow(previous.0 + 2))
+                .unwrap();
+            committer.commit(&table, &mut retry).unwrap();
+            let record = deserialize_commit_record(&ring.pop_bytes().unwrap().unwrap()).unwrap();
+            assert_eq!(record.writes.len(), 1);
+            assert_eq!(
+                table.latest_value(0).unwrap(),
+                Some(FaultyRow(previous.0 + 2))
+            );
+            assert_eq!(committer.wal_buffer.retained_output().0, 0);
+        }
+    }
+}
