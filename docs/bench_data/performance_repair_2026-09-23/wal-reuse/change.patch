+        let commit = record(5, 19);
+        let expected = serialize_commit_record(&commit).unwrap();
+        {
+            let mut lease = buffer.lease();
+            let error = lease.with_serializer(|serializer| {
+                leave_partial_serialization(serializer);
+                Err(WalRingError::Serialize(
+                    "injected after partial archive".into(),
+                ))
+            });
+            assert!(matches!(error, Err(WalRingError::Serialize(_))));
+            lease.serialize_commit(&commit).unwrap();
+            assert_eq!(lease.as_slice(), expected.as_slice());
+        }
+        // Failed oversized output must not remain retained after the call.
+        assert_eq!(buffer.output.len(), 0);
+        assert_eq!(buffer.output.capacity(), 0);
+        let mut lease = buffer.lease();
+        lease.serialize_commit(&commit).unwrap();
+        assert_eq!(lease.as_slice(), expected.as_slice());
+    }
