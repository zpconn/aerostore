+    fn leave_partial_serialization(serializer: &mut ReusableWalSerializer<'_>) {
+        serializer
+            .write(&vec![0x99; MAX_RETAINED_WAL_OUTPUT_BYTES + 1])
+            .unwrap();
+        // Intentionally leave both allocations unpopped: an error or unwind
+        // can interrupt an archive serializer before its balanced cleanup.
+        unsafe {
+            serializer
+                .push_scratch(Layout::from_size_align(4096, 16).unwrap())
+                .unwrap();
+            serializer
+                .push_scratch(Layout::from_size_align(16384, 16).unwrap())
+                .unwrap();
+        }
+    }
