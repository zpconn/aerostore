+// Each committer owns its output and 8 KiB scratch backing. Serializer cursors
+// are rebuilt for every attempt, including after a codec error or unwind. No
+// serializer state or shared-reference map crosses record boundaries.
+const WAL_SERIALIZATION_SCRATCH_BYTES: usize = 8192;
+const MAX_RETAINED_WAL_OUTPUT_BYTES: usize = 64 * 1024;
+
+type ReusableWalSerializer<'a> = CompositeSerializer<
+    AlignedSerializer<&'a mut AlignedVec>,
+    FallbackScratch<
+        BufferScratch<&'a mut AlignedBytes<WAL_SERIALIZATION_SCRATCH_BYTES>>,
+        AllocScratch,
+    >,
+    SharedSerializeMap,
+>;
+
+pub(crate) struct WalCommitBuffer {
+    output: AlignedVec,
+    scratch: Box<AlignedBytes<WAL_SERIALIZATION_SCRATCH_BYTES>>,
+}
+
+impl Default for WalCommitBuffer {
+    fn default() -> Self {
+        Self {
+            output: AlignedVec::new(),
+            scratch: Box::new(AlignedBytes::default()),
+        }
+    }
+}
+
+impl WalCommitBuffer {
+    #[cfg(test)]
+    pub(crate) fn retained_output(&self) -> (usize, usize) {
+        (self.output.len(), self.output.capacity())
+    }
+
+    pub(crate) fn lease(&mut self) -> WalCommitBufferLease<'_> {
+        WalCommitBufferLease { buffer: self }
+    }
+}
+
+// Keep this lease in the caller of the guarded commit driver. Acceptance only
+// borrows it, so clearing or freeing oversized output happens after guard
+// release, on both normal return and unwind.
+pub(crate) struct WalCommitBufferLease<'a> {
+    buffer: &'a mut WalCommitBuffer,
+}
+
+impl WalCommitBufferLease<'_> {
+    pub(crate) fn serialize_commit(&mut self, commit: &WalRingCommit) -> Result<(), WalRingError> {
+        self.with_serializer(|serializer| {
+            serializer
+                .serialize_value(commit)
+                .map_err(|err| WalRingError::Serialize(err.to_string()))?;
+            Ok(())
+        })
+    }
+
+    fn with_serializer<F>(&mut self, serialize: F) -> Result<(), WalRingError>
+    where
+        F: FnOnce(&mut ReusableWalSerializer<'_>) -> Result<(), WalRingError>,
+    {
+        self.buffer.output.clear();
+        let mut serializer = CompositeSerializer::new(
+            AlignedSerializer::new(&mut self.buffer.output),
+            FallbackScratch::new(
+                BufferScratch::new(self.buffer.scratch.as_mut()),
+                AllocScratch::default(),
+            ),
+            SharedSerializeMap::default(),
+        );
+        serialize(&mut serializer)
+    }
+
+    pub(crate) fn as_slice(&self) -> &[u8] {
+        self.buffer.output.as_slice()
+    }
+}
+
+impl Drop for WalCommitBufferLease<'_> {
+    fn drop(&mut self) {
+        if self.buffer.output.capacity() > MAX_RETAINED_WAL_OUTPUT_BYTES {
+            self.buffer.output = AlignedVec::new();
+        } else {
+            self.buffer.output.clear();
+        }
+    }
+}
+
 pub fn serialize_commit_record(commit: &WalRingCommit) -> Result<AlignedVec, WalRingError> {
     rkyv::to_bytes::<_, 8192>(commit).map_err(|err| WalRingError::Serialize(err.to_string()))
 }
