+#[test]
+#[should_panic(expected = "inconsistent latency histogram")]
+fn rejects_inconsistent_sample_total_instead_of_returning_a_fake_tail() {
+    percentile_bounds(&histogram(&[1, 2, 3]), 4, 99);
+}
